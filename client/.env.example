# OutRisk UTP — Client Environment Configuration Template
# Copy this file to .env and adjust values as needed.

# Base URL for the backend API.
# In local development with Vite dev server proxy, set to /api or leave empty.
# In production, set to your backend URL (e.g. https://outrisk-utp.onrender.com).
VITE_API_URL=https://outrisk-utp.onrender.com

# Backend target URL for Vite dev server proxy (used when VITE_API_URL is /api)
OUTRISK_API_URL=http://127.0.0.1:8000
